# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/careermatch_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_careermatch_2026
JWT_EXPIRES_IN=7d

# Private Object Storage (S3 / Supabase / Cloudflare R2)
STORAGE_ENDPOINT=https://your-storage-endpoint
STORAGE_BUCKET=careermatch-cv-vault
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# Backend AI Service URL
AI_SERVICE_URL=http://localhost:8001

